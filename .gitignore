node_modules/
dist/
*.log

# TypeScript incremental build cache
*.tsbuildinfo

# Server data: the generated library + segments, options, secrets (remote-token hashes),
# the standby log — generated or private, never commit anything from here
data/

# Bible modules live here in the project (large binaries, not version-controlled)
modules/

# Old apps and source assets kept locally, not part of the new build
old/

# Third-party texts have their own licences (many translations and song collections are
# still under copyright) — keep them out of the repository wherever they end up:
# MyBible modules, downloaded module archives, generated libraries/segments, song decks
*.SQLite3
*.sqlite3
*.SQLite3-shm
*.SQLite3-wal
*.sqlite
*.db
*.db-shm
*.db-wal
*.vodb
*.vodb.gz
*.zip
*.ppt
*.pptx
web/public/segments/

# Secrets and certificates (e.g. a future HTTPS setup for phones on the LAN)
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Whole-history dumps (git bundles for moving work between machines)
*.bundle

# AI-assisted dev tooling (Claude Code) — kept local, not part of the project
.claude/
.mcp.json
